</Properties></DataType><DataType><Name Namespace="Tc3_EventLogger">FB_ListenerBase2</Name><BitSize>256</BitSize><Implements Namespace="Tc3_EventLogger">I_Listener2</Implements><PropertyItem><Name NoSetter="true">bSubscribed</Name><Type>BOOL</Type><BitSize>8</BitSize><GetCodeOffs>566416</GetCodeOffs></PropertyItem><Method><Name>Subscribe2</Name><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>ipEventFilter</Name><Type Namespace="Tc3_EventLogger">I_TcEventFilterBase</Type><BitSize>64</BitSize></Parameter><Local><Name>hr</Name><Type GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</Type><BitSize>32</BitSize></Local></Method><Method><Name>OnAlarmRaised</Name><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>fbEvent</Name><Type Namespace="Tc3_EventLogger" ReferenceTo="true">FB_TcEvent</Type><BitSize>64</BitSize></Parameter></Method><Method><Name>Unsubscribe</Name><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Local><Name>hr</Name><Type GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</Type><BitSize>32</BitSize></Local></Method><Method><Name>OnAlarmCleared</Name><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>fbEvent</Name><Type Namespace="Tc3_EventLogger" ReferenceTo="true">FB_TcEvent</Type><BitSize>64</BitSize></Parameter></Method><Method><Name RpcEnable="plc" VTableIndex="6">__getbSubscribed</Name><ReturnType RpcDirection="out">BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Local><Name>bSubscribed</Name><Type>BOOL</Type><BitSize>8</BitSize></Local><Properties><Property><Name>property</Name></Property></Properties></Method><Method><Name>OnMessageSent</Name><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>fbEvent</Name><Type Namespace="Tc3_EventLogger" ReferenceTo="true">FB_TcEvent</Type><BitSize>64</BitSize></Parameter></Method><Method><Name>Subscribe</Name><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>ipMessageFilterConfig</Name><Type GUID="{70904B1B-F00E-4FCB-BE59-151086E9B8F6}" PointerTo="1">ITcEventFilterConfig</Type><BitSize>64</BitSize></Parameter><Parameter><Name>ipAlarmFilterConfig</Name><Type GUID="{70904B1B-F00E-4FCB-BE59-151086E9B8F6}" PointerTo="1">ITcEventFilterConfig</Type><BitSize>64</BitSize></Parameter><Local><Name>hr</Name><Type GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</Type><BitSize>32</BitSize></Local></Method><Method><Name>OnAlarmConfirmed</Name><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>fbEvent</Name><Type Namespace="Tc3_EventLogger" ReferenceTo="true">FB_TcEvent</Type><BitSize>64</BitSize></Parameter></Method><Method><Name>OnAlarmDisposed</Name><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>fbEvent</Name><Type Namespace="Tc3_EventLogger" ReferenceTo="true">FB_TcEvent</Type><BitSize>64</BitSize></Parameter></Method><Method><Name>Execute</Name><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Local><Name>hr</Name><Type GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</Type><BitSize>32</BitSize></Local></Method><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property><Property><Name>no_explicit_call</Name><Value>do not call this POU directly</Value></Property></Properties></DataType><DataType><Name>FB_ActiveAlarmListener</Name><Comment><![CDATA[ Generic, application-independent "active alarm list" for the PLC.
 A PLC-side replacement for what FB_ReadTc3Events does for the visu event table,
 but without the visualization dependency and with structured data instead of text.

 Dependencies: Tc3_EventLogger, Tc2_System (MEMCMP), ST_EventListEntry, I_ActiveAlarmList.

 The APPLICATION owns the storage and passes it in as variable-length arrays (ARRAY[*]),
 so the table sizes are decided where the FB is used - no parameter list / GVL needed:
   aActiveAlarms[]   - every alarm that is ACTIVE: raised, or cleared but still waiting for
                       confirmation (same meaning as FB_TcAlarm.bActive). Added in OnAlarmRaised,
                       removed when the alarm is neither raised nor waiting for confirmation
                       (OnAlarmCleared / OnAlarmConfirmed / OnAlarmDisposed).
   aRecentMessages[] - ring buffer of the last N messages, each tagged with a running nSequence

 Usage:
   VAR
       fbList          : FB_ActiveAlarmListener;
       aActiveAlarms   : ARRAY[1..128] OF ST_EventListEntry;   // any size, any bounds
       aRecentMessages : ARRAY[1..32]  OF ST_EventListEntry;
   END_VAR
   fbFilter.Clear().EventClass.EqualTo(<class>.uuidEventClass);        // or any other filter
   fbList.Subscribe2(fbFilter);                                         // once; Subscribe() = everything
   fbList(aActiveAlarms := aActiveAlarms, aRecentMessages := aRecentMessages);   // EVERY cycle
   fbConsumer(ipAlarmList := fbList, ...);                              // consumers take I_ActiveAlarmList

 Notes:
   - call the FB body every cycle: it binds the arrays and processes the event queue (callbacks below)
   - only events raised AFTER Subscribe are seen (no history replay by the EventLogger)
   - alarm identity = event class + event id + source id (what the EventLogger keys an alarm instance on)
   - the fbEvent REFERENCE handed to the callbacks must not be stored, so fields are copied out
